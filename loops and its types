#1 FOR LOOP-executes a code repetedly for number of times equal to items in a collection

#STRING EXAMPLE
name="hello world"
for char in name:
    print(char)

#LISTS EXAMPLE
fruits=["apple","banana"]
for f in fruits:
    print(f)

#DICTIONARIES EXAMPLE
student_marks={'kushi':90,'impana':100}
for i in student_marks:
 print(i,student_marks[i])

 #CONTINUE AND BREAK
 for number in range(1,21):
    if number%5==0:
     continue
     print(number)

for number in range(1,9):
   if number%3==0:
      break
   print(number)

#2 WHILE LOOP-condition must be always true
number=99
while number<106:
   print(number)
   number=number+1

number=1
while number<=10:
   print(number)
   number=number+1

# infinite loop-loop that never ends
number=18
while number>17:
  print(number)
  number=number+1
  break

